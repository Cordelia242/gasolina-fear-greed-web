    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet html = '';\n\nif (typeof input === 'string') {\n  html = input;\n} else {\n  const candidates = [input.body, input.data, input.response, input.html, ...Object.values(input)];\n  html = candidates.find(v => typeof v === 'string' && v.includes('Volumen disponible')) || '';\n}\n\nif (!html || !html.includes('Volumen disponible')) {\n  throw new Error('La respuesta de BioCloud no contiene \"Volumen disponible\". Se cancela para no publicar datos incorrectos.');\n}\n\nfunction decodeEntities(str) {\n  const map = {\n    '&nbsp;': ' ', '&amp;': '&', '&quot;': '\"', '&#39;': \"'\",\n    '&apos;': \"'\", '&lt;': '<', '&gt;': '>'\n  };\n  return str\n    .replace(/&(?:nbsp|amp|quot|#39|apos|lt|gt);/g, m => map[m] || m)\n    .replace(/&#(\\d+);/g, (_, n) => String.fromCharCode(Number(n)));\n}\n\nconst text = decodeEntities(\n  html\n    .replace(/<script\\b[^>]*>[\\s\\S]*?<\\/script>/gi, '\\n')\n    .replace(/<style\\b[^>]*>[\\s\\S]*?<\\/style>/gi, '\\n')\n    .replace(/<!--[\\s\\S]*?-->/g, '\\n')\n    .replace(/<br\\s*\\/?>/gi, '\\n')\n    .replace(/<\\/(?:div|p|h[1-6]|li|section|article|tr|td)>/gi, '\\n')\n    .replace(/<[^>]+>/g, ' ')\n).replace(/\\r/g, '\\n');\n\nconst lines = text\n  .split('\\n')\n  .map(s => s.replace(/\\s+/g, ' ').trim())\n  .filter(Boolean);\n\nconst measuredText = lines.find(l => /Última medición/i.test(l)) || '';\nconst measuredMatch = measuredText.match(/(\\d{4}-\\d{2}-\\d{2})\\s+(\\d{1,2}:\\d{2})/);\nconst sourceMeasuredAt = measuredMatch ? `${measuredMatch[1]}T${measuredMatch[2]}:00` : null;\n\nfunction intFrom(line) {\n  const m = String(line || '').match(/([\\d.,]+)/);\n  if (!m) return null;\n  return Number(m[1].replace(/[.,]/g, ''));\n}\n\nfunction stationKey(name) {\n  return name\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, '-')\n    .replace(/^-|-$/g, '');\n}\n\nconst stations = [];\n\nfor (let i = 0; i < lines.length; i++) {\n  if (!/^Volumen disponible$/i.test(lines[i])) continue;\n\n  const name = lines[i - 1];\n  const volume = intFrom(lines[i + 1]);\n  if (!name || !Number.isFinite(volume)) continue;\n\n  let vehicles = null;\n  let queueMinutes = null;\n  let address = null;\n\n  for (let j = i + 2; j < Math.min(lines.length, i + 16); j++) {\n    const line = lines[j];\n\n    if (/^El volumen alcanza aprox\\.? para$/i.test(line)) {\n      vehicles = intFrom(lines[j + 1]);\n      continue;\n    }\n    if (/^Un vehículo en cola avanza cada$/i.test(line)) {\n      queueMinutes = intFrom(lines[j + 1]);\n      continue;\n    }\n    if (/^UBICACION$/i.test(line) && j > 0) {\n      address = lines[j - 1];\n      break;\n    }\n    if (/^Volumen disponible$/i.test(line)) break;\n  }\n\n  stations.push({\n    key: stationKey(name),\n    name,\n    address,\n    liters: volume,\n    vehiclesEstimated: vehicles,\n    queueMinutes\n  });\n}\n\nif (stations.length < 1) {\n  throw new Error('No se extrajo ningún surtidor. Se cancela la publicación.');\n}\n\nreturn [{\n  json: {\n    sourceMeasuredAt,\n    visibleStationCount: stations.length,\n    stations\n  }\n}];"
      },
